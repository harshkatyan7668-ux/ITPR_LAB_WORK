        "#input two number\n",
        "num1=int(input(\"Enter first number :\"))\n",
        "num2=int(input(\"Enter second number :\"))\n",
        "#-------------------------------------------\n",
        "if(num2==0):\n",
        "  print(\"HCF is\",num1)\n",
        "else:\n",
        "  while(num2!=0):\n",
        "    rem=num1%num2\n",
        "    num1=num2\n",
        "    num2=rem\n",
        "#------------------------------------------\n",
        "print(\"HCF:\",num1)"
